# Launcher settings. Copy to ~/.config/iso-claude/.env and fill in for your
# machine; every bin/ script loads it. (A repo-local ./.env is also read by
# compose, but the ~/.config file wins, and ./.env sits inside the workspace
# mount.) Secrets (CLAUDE_CODE_OAUTH_TOKEN, GH_TOKEN) do NOT go here: they go in
# ~/.local/state/iso-claude-launcher/.env, 0600 (see README).

# Host dir where your project files live (bind-mounted to /opt/workspace).
CLAUDE_WORK_DIR=/home/you/claude-work

# Host dir where Claude's durable state (config, auth, history, project trust)
# is persisted, kept separate from your project files. Defaults to
# ~/.local/state/iso-claude if unset.
#CLAUDE_STATE_DIR=/home/you/.local/state/iso-claude

# Your host uid/gid (`id -u`, `id -g`), baked into the image's iso-claude user at
# build time so sessions can write their own $HOME. Default 1000.
#ISO_UID=1000
#ISO_GID=1000
